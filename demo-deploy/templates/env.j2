# Rendered by demo-deploy from templates/env.j2 and inventory.yml: edit those, a deployment overwrites this file.
NES_DOCKER_TAG={{ demo_tag }}
NES_IMAGE_REPO={{ registry }}
{% if 'hub' in group_names %}
# The hub: broker, web UI, generators and the queries service (`ui` profile, all services).
COMPOSE_PROFILES=ui
DEMO_SERVICES=
{% else %}
# The edge: only the worker; the broker runs on the hub.
COMPOSE_PROFILES=headless
DEMO_SERVICES=worker
NES_MQTT_HOST={{ hub_host }}
{% endif %}
NES_DATA_ADDRESS={{ ansible_host }}:9090
# ALSA card of the microphone, empty on the Pi without it.
MICROPHONE={{ microphone | default('') }}
