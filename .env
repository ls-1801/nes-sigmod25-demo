# Profiles started by default. The web UI and the MQTT broker are the `ui` profile; `docker compose --profile headless up`
# starts everything else.
COMPOSE_PROFILES=ui

# Two workers (see the workers of topology.yaml): this device is the hub, with the broker, the UI, the MQTT sinks and the
# queries service; the edge device (192.168.1.103) has the sources, the microphone and most operators.
NES_DATA_ADDRESS=192.168.1.102:9090
MICROPHONE=
